NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin for share images; Vercel production domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2: server-only; set in .env.local and each deployment environment.
# Copy the S3 API endpoint from R2 (include jurisdiction suffix when applicable).
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Bucket Custom Domain for production; Public Development URL (r2.dev) for development only.
R2_PUBLIC_URL=https://media.example.com
